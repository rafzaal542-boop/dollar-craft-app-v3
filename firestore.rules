rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users Collection - Allow read & write for cross-device synchronization and Admin management
    match /users/{userId} {
      allow read, write: if true;
    }

    // Deposits Collection
    match /deposits/{docId} {
      allow read, write: if true;
    }
  }
}
